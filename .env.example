# Copy this file to .env.local and fill in the values.
# Do not commit .env.local. All values here are server-only.

# Your store name, the unique name of your Phasio store. It is the name in the URL
# of your Phasio-hosted storefront, for example my-store in https://o.eu.phas.io/en/my-store
# (o.us.phas.io for US accounts). It is case-sensitive. A wrong name makes the
# Customer API calls fail with status 401.
STORE_NAME=your-store-name

# Base URLs for the region of your Phasio account.
#   EU: https://auth.eu.phas.io and https://c-api.eu.phas.io
#   US: https://auth.us.phas.io and https://c-api.us.phas.io
AUTH_SERVER=https://auth.eu.phas.io
API_BASE=https://c-api.eu.phas.io

# Storefront credentials. Create them at <AUTH_SERVER>/account?tab=custom-storefronts
AUTH_CLIENT_ID=sf_replace_me
AUTH_CLIENT_SECRET=sfs_replace_me
