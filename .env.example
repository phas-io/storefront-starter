# Copy this file to .env.local and fill in the values.
# Do not commit .env.local. All values here are server-only.

# Your store name (the unique name of your Phasio store).
STORE_NAME=your-store-name

# Base URLs for your region. Phasio gives you these values.
AUTH_SERVER=https://auth.eu.phas.io
API_BASE=https://c-api.eu.phas.io

# Storefront credentials. Create them at <AUTH_SERVER>/account?tab=custom-storefronts
AUTH_CLIENT_ID=sf_replace_me
AUTH_CLIENT_SECRET=sfs_replace_me
